{
  "name": "@sitetrack/sdk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "前端监控 SDK，同时提供 ESM 和 UMD",
  "main": "./dist/index.umd.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./dist/index.umd.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "~5.9.2",
    "vite": "^7.1.7"
  }
}
